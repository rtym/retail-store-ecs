@startuml scenario-SQA-3
!include plantuml-theme.puml
left to right direction
hide stereotype
title Quality attribute scenario — SQA-3 — Security / accountability
rectangle "<b>Source of stimulus</b>\nCompromised IAM principal in the shared account" as SRC #E7E3F3
rectangle "<b>Stimulus</b>\nChanges a security group or reads a database secret" as STIM #E7E3F3
rectangle "<b>Artifact</b>\nAccount audit and detection services" as ART #EDF2F8
rectangle "<b>Response</b>\nThe action is recorded and the security function alerted" as RESP #E4F0E9
rectangle "<b>Response measure</b>\nProposed — confirm: 100 % of API calls recorded; alert within 15 min" as MEAS #E4F0E9
rectangle "<b>Environment</b>\nNormal operation" as ENV #F5EEE3
SRC  --> STIM : generates
STIM --> ART  : arrives at
ART  --> RESP : produces
RESP --> MEAS : measured by
ENV  ..> ART
@enduml
