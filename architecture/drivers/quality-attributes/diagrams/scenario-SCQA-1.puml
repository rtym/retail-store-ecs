@startuml scenario-SCQA-1
!include plantuml-theme.puml
left to right direction
hide stereotype
title Quality attribute scenario — SCQA-1 — Flexibility / scalability
rectangle "<b>Source of stimulus</b>\nMarketing event" as SRC #E7E3F3
rectangle "<b>Stimulus</b>\nRequest rate grows 10× within 10 minutes and later falls back" as STIM #E7E3F3
rectangle "<b>Artifact</b>\nECS services and their data stores" as ART #EDF2F8
rectangle "<b>Response</b>\nTask count scales out with demand and back in afterwards" as RESP #E4F0E9
rectangle "<b>Response measure</b>\nProposed — confirm: capacity added within 5 min, < 1 % 5xx during the spike; back to baseline within 30 min after it" as MEAS #E4F0E9
rectangle "<b>Environment</b>\nPeak load" as ENV #F5EEE3
SRC  --> STIM : generates
STIM --> ART  : arrives at
ART  --> RESP : produces
RESP --> MEAS : measured by
ENV  ..> ART
@enduml
