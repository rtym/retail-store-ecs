@startuml seq-security-credentials
!include plantuml-theme.puml
title Credential flow at task start (UC-6) and on order write (UC-5)
autonumber
participant "ECS agent\n(Fargate)" as E
participant "Execution role\norders-te" as X
participant "Secrets Manager" as S
participant "KMS" as K
participant "orders container" as O
database "Aurora PostgreSQL" as P
E -> X : assume role for task start
X -> S : GetSecretValue retail-store-ecs-orders-db-*
S -> K : decrypt with the secret's key
K --> S : plaintext
S --> E : host, username, password
E -> O : start container with RETAIL_ORDERS_PERSISTENCE_* variables
O -> P : connect TCP 5432 (TLS not enforced), INSERT order
@enduml
